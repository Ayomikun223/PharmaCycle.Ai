{
  "name": "pharmacycle-ai",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaCycle.AI — Nigerian Pharmaceutical Redistribution Platform",
  "workspaces": [
    "pharmaexchange-frontend",
    "pharmaexchange-backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --prefix pharmaexchange-frontend",
    "dev:backend": "npm run dev --prefix pharmaexchange-backend",
    "build:frontend": "npm run build --prefix pharmaexchange-frontend",
    "start:frontend": "npm run start --prefix pharmaexchange-frontend",
    "start:backend": "npm run start --prefix pharmaexchange-backend",
    "install:all": "npm install --prefix pharmaexchange-frontend && npm install --prefix pharmaexchange-backend"
  }
}
